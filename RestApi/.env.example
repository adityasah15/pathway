# Copy this file to .env and change every value before running Docker Compose.
# Generate a JWT secret with: openssl rand -base64 48

DB_PASSWORD=change-me-strong-database-password

JWT_SECRET=change-me-at-least-32-bytes-long!!!
JWT_EXPIRATION_MS=3600000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change-me-strong-viewer-password

# demo seeds at least 24 students / 14 companies / 18 jobs / 80 applications.
SPRING_PROFILES_ACTIVE=demo
APP_DEMO_SEED=true
